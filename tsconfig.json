{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "@webgpu/types"],
    "paths": {
      "crayon": ["./scripts/vendor/crayon/mod.ts"],
      "jsonc": ["./scripts/vendor/jsonc/mod.ts"]
    }
  },
  "include": ["mod*.ts", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
