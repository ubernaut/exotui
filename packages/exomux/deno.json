{
  "name": "@ubernaut/exomux",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./main": "./main.ts"
  },
  "imports": {
    "@ubernaut/deno-tui": "../../mod.ts",
    "@ubernaut/deno-tui/app": "../../mod.app.ts",
    "@ubernaut/deno-tui/terminal": "../../mod.terminal.ts",
    "@ubernaut/deno-tui/testing": "../../mod.testing.ts",
    "@showcase/kit": "../../examples/showcases/shared/mod.ts",
    "@sigma/pty-ffi": "jsr:@sigma/pty-ffi@0.42.0",
    "jpeg-js": "npm:jpeg-js@0.4.4",
    "markdown-it": "npm:markdown-it@15.0.0",
    "std/assert": "https://deno.land/std@0.192.0/testing/asserts.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "nodeModulesDir": "none",
  "fmt": {
    "lineWidth": 120
  },
  "tasks": {
    "start": "deno run -A --unstable-webgpu ./main.ts",
    "memory": "deno run -A --unstable-webgpu ./main.ts --memory",
    "audio": "deno run --allow-env=EXOMUX_AUDIO_DEVICE --allow-run=parec,pw-record,arecord ./audio.ts",
    "check": "deno check ./main.ts",
    "test": "deno test -A --unstable-webgpu ./tests/",
    "compile": "deno compile -A --unstable-webgpu --output ./exomux ./main.ts"
  }
}
